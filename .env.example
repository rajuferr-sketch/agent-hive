# =============================================================================
# AgentHive — Environment configuration template
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite (zero-config, for local tests / development / chat use):
DATABASE_URL=sqlite+aiosqlite:///./data/agent_hive.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://agenthive:CHANGE_ME@localhost:5432/agenthive

# --- System behaviour -------------------------------------------------------
# Global "simulation" switch: providers may fall back to the deterministic
# mock provider. Responses produced in mock mode are always tagged "[MOCK]".
ALLOW_MOCK=true
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Directory containing configs/ (system.yaml + agents/*.yaml)
CONFIG_DIR=./configs
# Working directory agents may read/write files in (relative paths allowed)
WORKSPACE_DIR=./workspace
# Maximum concurrent tasks executed by the runtime
MAX_CONCURRENCY=8
# Default task timeout in seconds
DEFAULT_TASK_TIMEOUT=120
# Default max retries per task
DEFAULT_MAX_RETRIES=2

# --- API server -------------------------------------------------------------
# Use 0.0.0.0 inside Docker containers; use 127.0.0.1 for local development.
API_HOST=0.0.0.0
API_PORT=8000
# Enables file/http tools for agents (keep false in untrusted environments)
ENABLE_FILE_TOOLS=false
ENABLE_HTTP_TOOLS=false

# --- Provider credentials (real values only in your local .env) -------------
# Generic OpenAI-compatible endpoints (OpenAI, vLLM, LM Studio, LiteLLM...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama local runtime.
# For Docker on Windows/macOS use: http://host.docker.internal:11434
# For local (non-Docker) use: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Example: another commercial provider
ANTHROPIC_API_KEY=