# =============================================================================
# AgentHive — Environment configuration template
# Copy this file to `.env` and fill in your values. NEVER commit the real .env.
# =============================================================================

# --- Database ---------------------------------------------------------------
# SQLite (zero-config, for local tests / development / chat use):
DATABASE_URL=sqlite+aiosqlite:///./data/agent_hive.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://agenthive:CHANGE_ME@localhost:5432/agenthive

# --- System behaviour -------------------------------------------------------
# Global "simulation" switch: providers may fall back to the deterministic
# mock provider. Responses produced in mock mode are always tagged "[MOCK]".
ALLOW_MOCK=true
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Directory containing configs/ (system.yaml + agents/*.yaml)
CONFIG_DIR=./configs
# Working directory agents may read/write files in (relative paths allowed)
WORKSPACE_DIR=./workspace
# Maximum concurrent tasks executed by the runtime
MAX_CONCURRENCY=8
# Default task timeout in seconds
DEFAULT_TASK_TIMEOUT=120
# Default max retries per task
DEFAULT_MAX_RETRIES=2

# --- API server -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Enables file/http tools for agents (keep false in untrusted environments)
ENABLE_FILE_TOOLS=false
ENABLE_HTTP_TOOLS=false

# =============================================================================
# Universal AI Platform (MCP / Gateway / connectors / security)
# =============================================================================

# --- Security ---------------------------------------------------------------
# Master token (bootstrap admin). When set, the system runs in ENFORCED mode:
# every caller must present a valid token (this value or an issued one).
# Leave empty in trusted local setups (local-trust mode, zero configuration).
API_MASTER_TOKEN=
# Legacy static API key (still accepted as an admin token; prefer tokens)
AGENT_HIVE_API_KEY=
# Default lifetime for issued tokens (seconds)
TOKEN_DEFAULT_TTL=604800
# Rate limiting: requests per window per token/IP
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# --- Universal Gateway ------------------------------------------------------
# Max concurrent universal requests (semaphore bound)
GATEWAY_MAX_CONCURRENT=16
# Per-request timeout budget (seconds)
GATEWAY_REQUEST_TIMEOUT=300

# --- MCP server -------------------------------------------------------------
MCP_SERVER_NAME=agent-hive
# Default per-tool execution timeout (seconds)
MCP_TOOL_TIMEOUT=120
MCP_MAX_SESSIONS=256

# --- Self-heal --------------------------------------------------------------
SELFHEAL_ENABLED=true
SELFHEAL_INTERVAL=30
SELFHEAL_MAX_RETRIES=3
SELFHEAL_BUDGET_S=60
SELFHEAL_FAIL_LIMIT=5

# --- Universal shared memory ------------------------------------------------
# Hashed-embedding vector dimensions (swap a real embedder without schema change)
UNIVERSAL_MEMORY_DIMS=128
# Default TTL for records without explicit ttl_seconds (0 = no expiry)
UNIVERSAL_MEMORY_TTL_DEFAULT=0

# --- GitHub integration -----------------------------------------------------
# read_only | assisted | semi_autonomous | autonomous (safety gates in docs/SECURITY.md)
AGENT_HIVE_GITHUB_MODE=read_only
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Provider credentials (real values only in your local .env) -------------
# Generic OpenAI-compatible endpoints (OpenAI, vLLM, LM Studio, LiteLLM...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama local runtime
OLLAMA_BASE_URL=http://localhost:11434
# Cloud providers (all OpenAI-compatible unless noted; see docs/LOCAL_MODELS.md
# and docs/GEMINI_SETUP.md for the native adapters)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
MISTRAL_API_KEY=
GROK_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
