# =============================================================================
# AgentHive — Environment configuration (DOCKER)
# Copy this file to `.env` when building/running with Docker Compose.
# =============================================================================

# --- Database ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agenthive:CHANGE_ME@db:5432/agenthive

# --- System behaviour -------------------------------------------------------
ALLOW_MOCK=false
LOG_LEVEL=INFO
CONFIG_DIR=/app/configs
WORKSPACE_DIR=/app/workspace
MAX_CONCURRENCY=8
DEFAULT_TASK_TIMEOUT=120
DEFAULT_MAX_RETRIES=2

# --- API server -------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
ENABLE_FILE_TOOLS=false
ENABLE_HTTP_TOOLS=false

# --- Provider credentials ---------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=